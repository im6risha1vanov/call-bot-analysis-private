      "version": 2,
      "kind": "practice",
      "steps": [
        {
          "action": "select_client",
          "title": "Откройте «Учебный Кедр».",
          "expected": {
            "client": "targetClient"
          },
          "screen": {
            "page": "queue",
            "selector": "[data-next] .item"
