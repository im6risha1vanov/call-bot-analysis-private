        {
          "action": "verify_outcome",
          "title": "Проверьте итог в истории клиента.",
          "expected": {},
          "screen": {
            "page": "queue",
            "selector": "[data-learning-target=\"client-history\"]"
          }
        }
      ],
      "guide": [
        {
          "page": "queue",
          "target": "queue-card",
          "text": "Откройте карточку нужного номера.",
          "result": "Название и номер относятся к вашему клиенту."
